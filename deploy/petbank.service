[Unit]
Description=PetBank application intake server
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/petbank
ExecStart=/usr/bin/python3 /opt/petbank/server.py
Environment=PORT=8000
Restart=on-failure
RestartSec=2

# Базовый hardening: сервису ничего лишнего на коробке не нужно.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
