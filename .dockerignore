# Что НЕ попадает в образ. Всё остальное (код, конфиги, openapi.yaml, контракты,
# метрики, логи-конфиги, доки) едет в образ автоматически — через `COPY . .` в Dockerfile.

# Секреты — никогда в образ
.env
.env.*

# VCS и CI
.git
.gitignore
.github

# Python-кеши и артефакты сборки
__pycache__
*.py[cod]
*.so
.pytest_cache
.mypy_cache

# Виртуальные окружения
.venv
venv
env
ENV

# IDE / агент / ОС
.idea
.vscode
.claude
.DS_Store

# Только для разработки/деплоя — в рантайме не нужны
tests
requirements-dev.txt
requests.http
docker-compose.yml
deploy

# Сам docker-обвес незачем класть внутрь образа
Dockerfile
.dockerignore

# Локальные рантайм-данные — не в образ (логи идут в stdout, БД — в volume)
*.log
*.db
*.sqlite3
