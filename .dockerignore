# В образ Dockerfile берёт только requirements.txt и папку app/.
# Здесь — что не тащить даже в build-контекст (быстрее сборка, без секретов/мусора).

# Секреты — никогда в образ
.env
.env.*

# VCS / CI
.git
.gitignore
.github

# Python-кеши и артефакты
__pycache__
*.py[cod]
*.so
.pytest_cache
.mypy_cache

# Окружения / IDE / агент / ОС
.venv
venv
env
ENV
.idea
.vscode
.claude
.DS_Store

# Не входит в образ (Dockerfile копирует только app/) — и в контексте не нужно.
# alembic гоняется отдельной job на раннере (migrate.yml), не в образе.
tests
docs
deploy
alembic
alembic.ini
requirements-dev.txt
requests.http
docker-compose.yml
*.md
*.log
*.db
*.sqlite3
